<Window x:Class="PartComparisionTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Part Comparison Tool - Tekla 2023"
        Width="1250"
        Height="760"
        MinWidth="950"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Part Comparison Tool"
                           FontSize="26"
                           FontWeight="SemiBold" />
                <TextBlock Text="Find an identical or quickly adaptable assembly from steel you select in the model."
                           Margin="0,4,0,0"
                           Foreground="DimGray" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="ConnectionText"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center" />
                <Button Content="Refresh connection"
                        Padding="12,7"
                        Click="RefreshButton_Click" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Margin="0,18,0,0"
                Padding="14"
                BorderBrush="#D8D8D8"
                BorderThickness="1"
                CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button x:Name="SetTargetButton"
                        Content="1. Set target from selection"
                        Padding="18,8"
                        FontWeight="SemiBold"
                        Click="SetTargetButton_Click" />

                <TextBlock Grid.Column="1"
                           Margin="14,0,22,0"
                           VerticalAlignment="Center"
                           Foreground="DimGray"
                           Text="Select one part from the missing assembly, then click this button." />

                <Button x:Name="SearchSelectionButton"
                        Grid.Column="2"
                        Content="2. Search selected steel"
                        Padding="18,8"
                        FontWeight="SemiBold"
                        Click="SearchSelectionButton_Click" />

                <TextBlock Grid.Column="3"
                           Margin="14,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="DimGray"
                           Text="Select all steel you want to search through, then click this button." />
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="TargetText"
                       FontWeight="SemiBold"
                       Text="No target selected yet." />
            <TextBlock x:Name="SearchSelectionText"
                       Margin="0,4,0,0"
                       Foreground="DimGray"
                       Text="No search selection processed yet." />
            <ProgressBar x:Name="SearchProgressBar"
                         Height="8"
                         Margin="0,9,0,0"
                         Minimum="0"
                         Maximum="1"
                         Value="0" />
            <TextBlock x:Name="StatusText"
                       Margin="0,6,0,0"
                       Foreground="DimGray"
                       Text="Ready." />
        </StackPanel>

        <Border Grid.Row="3"
                Margin="0,14,0,8"
                Padding="10"
                Background="#F5F5F5"
                CornerRadius="4">
            <TextBlock TextWrapping="Wrap">
                <Run FontWeight="SemiBold" Text="Results: " />
                <Run Text="Exact means no differences were found. Other rows say exactly what is missing, extra or different so you can judge whether the piece can be adapted quickly." />
            </TextBlock>
        </Border>

        <DataGrid x:Name="ResultsGrid"
                  Grid.Row="4"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  SelectionChanged="ResultsGrid_SelectionChanged"
                  MouseDoubleClick="ResultsGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Match" Binding="{Binding MatchText}" Width="95" />
                <DataGridTextColumn Header="Score" Binding="{Binding Score, StringFormat={}{0}%}" Width="70" />
                <DataGridTextColumn Header="Phase" Binding="{Binding Phase}" Width="60" />
                <DataGridTextColumn Header="Assembly" Binding="{Binding AssemblyMark}" Width="100" />
                <DataGridTextColumn Header="Main part" Binding="{Binding MainPartMark}" Width="95" />
                <DataGridTextColumn Header="Profile" Binding="{Binding Profile}" Width="130" />
                <DataGridTextColumn Header="Length" Binding="{Binding Length, StringFormat={}{0:0} mm}" Width="90" />
                <DataGridTextColumn Header="Weight" Binding="{Binding Weight, StringFormat={}{0:0.0} kg}" Width="90" />
                <DataGridTextColumn Header="Δ Weight" Binding="{Binding WeightDifference, StringFormat={}{0:+0.0;-0.0;0.0} kg}" Width="90" />
                <DataGridTextColumn Header="Fittings" Binding="{Binding FittingCount}" Width="70" />
                <DataGridTextColumn Header="What is different?" Binding="{Binding Differences}" Width="*" MinWidth="360" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="5" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock VerticalAlignment="Center"
                       Foreground="DimGray"
                       Text="Click a row to select that candidate in Tekla and zoom the model to it." />

            <Button Grid.Column="1"
                    Content="Select + zoom in Tekla"
                    Padding="16,8"
                    Click="SelectResultButton_Click" />
        </Grid>
    </Grid>
</Window>
